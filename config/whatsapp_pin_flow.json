{
  "version": "7.2",
  "data_api_version": "3.0",
  "routing_model": {
    "Pin": [
      "DONE"
    ],
    "DONE": []
  },
  "screens": [
    {
      "id": "Pin",
      "title": "Enter Transaction Pin",
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Form",
            "name": "flow_path",
            "children": [
              {
                "type": "TextHeading",
                "text": "Transaction Pin Required"
              },
              {
                "type": "TextBody",
                "text": "Please enter your 4-digit transaction pin to authorize your transaction"
              },
              {
                "type": "TextInput",
                "name": "pin",
                "label": "Enter Pin",
                "input-type": "passcode",
                "required": true,
                "min-chars": 4,
                "max-chars": 4,
                "helper-text": "Enter your transaction pin"
              },
              {
                "type": "Footer",
                "label": "Submit",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "pin": "${form.pin}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "DONE",
      "title": "Authorized",
      "terminal": true,
      "success": true,
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "Authorized"
          },
          {
            "type": "TextBody",
            "text": "You can close this screen."
          },
          {
            "type": "Footer",
            "label": "Done",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}
