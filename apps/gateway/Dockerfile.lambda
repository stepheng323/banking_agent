# syntax=docker/dockerfile:1.7
FROM public.ecr.aws/lambda/python:3.12 AS builder

WORKDIR /build
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --target /build ".[runtime-gateway]"

FROM public.ecr.aws/lambda/python:3.12

WORKDIR /var/task
COPY --from=builder /build /var/task/
COPY apps/core/ /var/task/apps/core/
COPY apps/gateway/ /var/task/apps/gateway/
COPY shared/ /var/task/shared/
COPY config/ /var/task/config/

ENV PYTHONPATH=/var/task
CMD ["apps.gateway.lambda_handler.handler"]
