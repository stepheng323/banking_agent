# syntax=docker/dockerfile:1.7
FROM public.ecr.aws/lambda/python:3.12 AS builder

WORKDIR /build
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --target /build ".[runtime-worker-messaging]"

FROM public.ecr.aws/lambda/python:3.12

WORKDIR /var/task
COPY --from=builder /build /var/task/
COPY apps/core/ /var/task/apps/core/
COPY apps/receipt/ /var/task/apps/receipt/
COPY shared/ /var/task/shared/
COPY config/ /var/task/config/

ENV PYTHONPATH=/var/task
CMD ["apps.core.src.lambda_handlers.messaging_worker_handler.handler"]
