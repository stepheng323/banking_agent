# syntax=docker/dockerfile:1.7
FROM public.ecr.aws/lambda/python:3.12 AS builder

WORKDIR /build
COPY pyproject.toml ./
RUN --mount=type=cache,target=/root/.cache/pip \
    pip install --upgrade pip && \
    pip install --target /build ".[runtime-worker-receipt]" && \
    PLAYWRIGHT_BROWSERS_PATH=/build/ms-playwright PYTHONPATH=/build python -m playwright install chromium

FROM public.ecr.aws/lambda/python:3.12

WORKDIR /var/task
COPY --from=builder /build /var/task/
COPY apps/core/ /var/task/apps/core/
COPY apps/receipt/ /var/task/apps/receipt/
COPY shared/ /var/task/shared/
COPY config/ /var/task/config/

# Install shared libraries required by Playwright Chromium at Lambda runtime.
RUN set -eux; \
    if command -v dnf >/dev/null 2>&1; then \
      dnf install -y \
        nspr nss \
        atk at-spi2-atk \
        libXcomposite libXdamage libXfixes libXrandr libXcursor libXi libXtst \
        mesa-libgbm pango alsa-lib cups-libs \
        libdrm libxkbcommon \
        gtk3; \
      dnf clean all; \
      rm -rf /var/cache/dnf; \
    elif command -v yum >/dev/null 2>&1; then \
      yum install -y \
        nspr nss \
        atk at-spi2-atk \
        libXcomposite libXdamage libXfixes libXrandr libXcursor libXi libXtst \
        mesa-libgbm pango alsa-lib cups-libs \
        libdrm libxkbcommon \
        gtk3; \
      yum clean all; \
      rm -rf /var/cache/yum; \
    else \
      echo "No supported package manager found (dnf/yum)"; \
      exit 1; \
    fi

ENV PYTHONPATH=/var/task \
    PLAYWRIGHT_BROWSERS_PATH=/var/task/ms-playwright
CMD ["apps.core.src.lambda_handlers.receipt_worker_handler.handler"]
