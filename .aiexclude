# Binary artifacts
*.pyc
*.o
*.so
*.dll
*.exe

# Local runtime/build artifacts
.venv*/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage*
htmlcov/

# Asset files (Agent tries to read them as text)
*.png
*.jpg
*.ico
*.pdf

# Lock files (sometimes contain complex encoding)
package-lock.json
yarn.lock
go.sum

# Large minified files
*.min.js
